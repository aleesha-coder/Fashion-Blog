@model Fashion_Blog.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->

<section class="hero bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">Welcome to FashionBlog</h1>
                <p class="lead">Daily Source of Fashion Inspiration, Style Guides and the Latest Trends</p>
                <a href="/Blog" class="btn btn-primary btn-lg">Read Our Blog</a>
            </div>
            <div class="col-lg-6">
                <img src="/images/hero-fashion.png" alt="Fashion" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Featured Posts -->
<section class="hero bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">Featured Posts</h2>
        <div class="row">
            @foreach (var post in Model.FeaturedPosts)
            {
                <div class="col-md-4">
                    <div class="card post-card">
                        <img src="@post.FeaturedImageUrl" class="card-img-top" alt="@post.Title">
                        <div class="card-body">
                            <a href="/Category/@post.Category.Slug" class="category-badge mb-2 d-inline-block">@post.Category.Name</a>
                            <h5 class="card-title">@post.Title</h5>
                            <p class="card-text">@post.Excerpt</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="far fa-calendar-alt"></i> @post.PublishedDate.ToString("MMM dd, yyyy")
                                </small>

                                <a href="/Blog/post/@post.Slug" class="btn btn-primary btn-sm">Read More</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Categories -->
<section class="categories bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">Explore Categories</h2>
        <div class="row">
            @foreach (var category in Model.Categories)
            {
                <div class="col-md-3 mb-3">
                    <a href="/Category/@category.Slug" class="text-decoration-none">
                    <div class="card text-center p-3">
                        <h5>@category.Name</h5>
                        <p class="text-muted">@category.PostCount posts</p>
                    </div> 
                    </a>
                </div>
            }
        </div>
    </div>
</section>


<!-- Recent Posts -->
<section class="recent-posts py-5">
    <div class="container">
        <h2 class="text-center mb-4">Recent Posts</h2>
        <div class="row">
            @foreach (var post in Model.RecentPosts)
            {
                <div class="col-md-6 mb-4">
                    <div class="card post-card flex-row">
                      <img src="@post.FeaturedImageUrl" alt="@post.Title" style="width: 200px; height: 100%;">
                      <div class="card-body">
                        <h5 class="card-title">@post.Title</h5>
                        <p class="card-text">@post.Excerpt</p>
                        <a href="/Blog/post/@post.Slug" class="btn btn-primary btn-sm">Read More</a>
                      </div>  
                    </div>
                </div>
            }
        </div>
    </div>
</section>